google_oauth.json

# Database dumps contain application data (scripts/pg-backup.sh)
backups/

# Playwright runtime output (curated e2e artifacts are tracked separately)
dashboard/e2e/test-results/
dashboard/test-results/
dashboard/playwright-report/

