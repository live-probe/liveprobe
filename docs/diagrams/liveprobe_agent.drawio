 id="e10" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#5B6B82;strokeColor=#C83A3A;fontColor=#C83A3A;curved=0;exitX=0.3334;exitY=0.1666;entryX=0.3333;entryY=1;" edge="1" source="c8" target="c6" parent="g_c"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="256.66999999999996" y="758.0"/><mxPoint x="166.83" y="758.0"/></Array><mxPoint x="0" y="-44.92" as="offset"/></mxGeometry></mxCell><mxCell id="e11" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#5B6B82;curved=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="c8" target="c_fin" parent="g_c"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="285.0" y="919.0"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="g_h" value="HIGH_RISK — high_risk_group" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fontSize=13;fontStyle=1;fillColor=#FCE8E8;strokeColor=#C83A3A;fontColor=#561313;" vertex="1" parent="1"><mxGeometry x="1450.0" y="240" width="240.0" height="316.0" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;evidence_curator&lt;/b&gt;&lt;br&gt;gpt-6.1-sol / medium&lt;br&gt;근거 정리" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FCE8E8;strokeColor=#C83A3A;fontColor=#561313;" vertex="1" parent="g_h"><mxGeometry x="20.0" y="54.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;safety_verifier&lt;/b&gt;&lt;br&gt;gpt-6-astra / xhigh&lt;br&gt;안전 검증" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FCE8E8;strokeColor=#C83A3A;fontColor=#561313;" vertex="1" parent="g_h"><mxGeometry x="20.0" y="148.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;자동 조치 중지&lt;/b&gt;&lt;br&gt;운영자 이관" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FCE8E8;strokeColor=#C83A3A;fontColor=#561313;" vertex="1" parent="g_h"><mxGeometry x="35.0" y="242.0" width="170" height="54" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#5B6B82;curved=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="h1" target="h2" parent="g_h"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120.0" y="133.0"/></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#5B6B82;curved=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="h2" target="h3" parent="g_h"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120.0" y="227.0"/></Array></mxGeometry></mxCell><mxCell id="rule1" value="&lt;b&gt;모든 Agent 공통 — 선택적 승격&lt;/b&gt;&lt;br&gt;출력 오류 · 인용 위조 · 없는 근거 번호 · 근거 없는 원인 · 신뢰도 &amp;lt; 0.6 → &lt;u&gt;그 Agent만&lt;/u&gt; 1회 승격&lt;br&gt;모델 luna → 6.1-sol → astra, 이미 최상위면 추론 강도 low → medium → high → xhigh&lt;br&gt;시간초과·인증 오류는 승격하지 않음(근거 문제가 아니므로)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFDF2;strokeColor=#D9CF9E;fontColor=#3D3A2A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="560" height="96" as="geometry"/></mxCell><mxCell id="rule2" value="&lt;b&gt;예산 게이트 (매 호출 전, NORMAL·COMPLEX)&lt;/b&gt;&lt;br&gt;호출 수 NORMAL 7 · COMPLEX 10&lt;br&gt;추정 비용 NORMAL $1.30 · COMPLEX $2.30 · 제한 시간 900초&lt;br&gt;넘으면 그 자리에서 중단 → 이관" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFDF2;strokeColor=#D9CF9E;fontColor=#3D3A2A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="600" y="20" width="440" height="96" as="geometry"/></mxCell><mxCell id="rule3" value="&lt;b&gt;finalize (NORMAL·COMPLEX 공통)&lt;/b&gt;&lt;br&gt;근거가 확인된 원인 후보만 최대 3개 · 독립 검증 supported 필요&lt;br&gt;검증자가 &lt;u&gt;같은 조치&lt;/u&gt;를 승인 + 허용 목록·이전 리비전·대상 확인 통과 → 조치 제안&lt;br&gt;그 외 → 원인 후보·반론·권장 절차를 붙여 운영자 이관" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFDF2;strokeColor=#D9CF9E;fontColor=#3D3A2A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1060" y="20" width="560" height="96" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;모델 등급&lt;/b&gt;&lt;br&gt;낮음 gpt-6-luna · 중간 gpt-6.1-sol · 최고 gpt-6-astra&lt;br&gt;빨간 선 = 반박 시 재검토 경로(최대 1회)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFDF2;strokeColor=#D9CF9E;fontColor=#3D3A2A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1640" y="20" width="380" height="96" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
  <diagram name="2 LiveProbe 메가 프로세스" id="3ffcf0cb77a95bf8b802">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1" value="&lt;b style='font-size:14px'&gt;1. 감시·사건화&lt;/b&gt;&lt;hr size='1'&gt;Pod·Event watch, Endpoint 폴링&lt;br&gt;Alertmanager 경보 수신(웹훅)&lt;br&gt;Hubble 흐름 → 지도 네트워크 경고&lt;br&gt;지문 병합·재발 억제·평가 잠금" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E8F1FF;strokeColor=#3B6FD8;fontColor=#12305E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="300" height="150" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b style='font-size:14px'&gt;2. 근거 수집·정리&lt;/b&gt;&lt;hr size='1'&gt;K8s 상태·리비전·Event (읽기 전용)&lt;br&gt;Prometheus 지표·Loki 로그(사건 시점 기준)&lt;br&gt;E1~E7 요약 · 비밀값 가림&lt;br&gt;수집 실패도 근거로 남김" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#F4F7FB;strokeColor=#8A9BB3;fontColor=#1F2A37;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="420" y="160" width="300" height="150" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b style='font-size:14px'&gt;3. 수준 판단·Workflow·모델 선택&lt;/b&gt;&lt;hr size='1'&gt;규칙 + LLM 분류(올리기만)&lt;br&gt;SIMPLE·NORMAL·COMPLEX·HIGH_RISK&lt;br&gt;품질·비용·처리량 점수로 주 모델 선택&lt;br&gt;선택 이유·점수 저장" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#F1EAFE;strokeColor=#7A55D8;fontColor=#2E1A66;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="300" height="150" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b style='font-size:14px'&gt;4. Agents Group 분석·검증&lt;/b&gt;&lt;hr size='1'&gt;LangGraph 상태 그래프(순차·병렬·분기)&lt;br&gt;역할별 luna / 6.1-sol / astra 혼합&lt;br&gt;인용 검사·선택적 승격·조기 종료&lt;br&gt;예산 게이트·독립 검증" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E6F4F8;strokeColor=#2B8BAA;fontColor=#0E3A49;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1180" y="160" width="300" height="150" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b style='font-size:14px'&gt;5. 안전 조치·검증·원복&lt;/b&gt;&lt;hr size='1'&gt;허용 조치 6종(롤백·재시작·파드 삭제·복제·메모리·설정)&lt;br&gt;정책·한도·admission 정책&lt;br&gt;before 스냅샷 → 실행 → 검증 → 보상&lt;br&gt;롤백은 전용 롤백 컨트롤러" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E7F6EC;strokeColor=#2F9A55;fontColor=#11402A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1180" y="460" width="300" height="150" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b style='font-size:14px'&gt;6. 운영자 이관·개입&lt;/b&gt;&lt;hr size='1'&gt;이관 패키지(원인 후보·근거·반론·절차)&lt;br&gt;인수(claim)·승인/거절&lt;br&gt;실행 중 지시 메시지·일시정지·중단" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FCE8E8;strokeColor=#C83A3A;fontColor=#561313;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="610" y="460" width="300" height="150" as="geometry"/></mxCell><mxCell id="p7" value="&lt;b style='font-size:14px'&gt;7. 기록·학습&lt;/b&gt;&lt;hr size='1'&gt;사건·근거·라우팅·Agent 호출·조치·감사 로그&lt;br&gt;실행 기록 스트림(SSE)·검토 장부&lt;br&gt;종료 사건 → RAG 과거 사건 색인" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#5B6B82;fontColor=#1F2A37;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="610" y="760" width="300" height="150" as="geometry"/></mxCell><mxCell id="p8" value="&lt;b style='font-size:14px'&gt;8. 운영 대시보드&lt;/b&gt;&lt;hr size='1'&gt;첫 화면 Kiali(실제 메시)&lt;br&gt;서비스 지도·사건 작업 화면&lt;br&gt;검토 장부·설정(자동화 모드)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#5B6B82;fontColor=#1F2A37;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="300" height="150" as="geometry"/></mxCell><mxCell id="p9" value="&lt;b style='font-size:14px'&gt;9. 평가 (오프라인)&lt;/b&gt;&lt;hr size='1'&gt;장애 사례 60 + 새 사례 12 주입·복구&lt;br&gt;4방식 비교(Single-small/High, Fixed, Adaptive)&lt;br&gt;지표 엔진·정답 유출 검사·결과보고서" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#EEF1F5;strokeColor=#9AA6B6;fontColor=#2C3440;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="300" height="150" as="geometry"/></mxCell><mxCell id="hub" value="Retina / Hubble&lt;br&gt;(네트워크 흐름)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#EEF1F5;strokeColor=#9AA6B6;fontColor=#2C3440;dashed=1;" vertex="1" parent="1"><mxGeometry x="90" y="30" width="200" height="60" as="geometry"/></mxCell><mxCell id="k8s" value="Kubernetes API&lt;br&gt;(관찰 계정 / 쓰기 계정 분리)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#EEF1F5;strokeColor=#9AA6B6;fontColor=#2C3440;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="30" width="200" height="60" as="geometry"/></mxCell><mxCell id="obs" value="Prometheus · Loki&lt;br&gt;Alertmanager" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#EEF1F5;strokeColor=#9AA6B6;fontColor=#2C3440;dashed=1;" vertex="1" parent="1"><mxGeometry x="850" y="30" width="200" height="60" as="geometry"/></mxCell><mxCell id="llmx" value="Codex CLI (구독)&lt;br&gt;gpt-6-luna · 6.1-sol · astra" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#EEF1F5;strokeColor=#9AA6B6;fontColor=#2C3440;dashed=1;" vertex="1" parent="1"><mxGeometry x="1230" y="30" width="200" height="60" as="geometry"/></mxCell><mxCell id="db" value="PostgreSQL + pgvector&lt;br&gt;(사건·감사·RAG)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#EEF1F5;strokeColor=#9AA6B6;fontColor=#2C3440;dashed=1;" vertex="1" parent="1"><mxGeometry x="1230" y="805" width="200" height="60" as="geometry"/></mxCell><mxCell id="e1" value="사건 생성" style="fontSize=11;endArrow=block;endFill=1;strokeColor=#5B6B82;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" source="p1" target="p2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="근거 묶음" style="fontSize=11;endArrow=block;endFill=1;strokeColor=#5B6B82;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" source="p2" target="p3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="수준·Group·모델" style="fontSize=11;endArrow=block;endFill=1;strokeColor=#5B6B82;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" source="p3" target="p4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="검증된 조치 제안" style="fontSize=11;endArrow=block;endFill=1;strokeColor=#5B6B82;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" source="p4" target="p5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="저신뢰·고위험·미해결" style="fontSize=11;endArrow=block;endFill=1;strokeColor=#5B6B82;strokeColor=#C83A3A;fontColor=#C83A3A;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" source="p4" target="p6" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1133" y="235" /><mxPoint x="1133" y="535" /></Array></mxGeometry></mxCell><mxCell id="e6" value="검증 실패·승인 대기" style="fontSize=11;endArrow=block;endFill=1;strokeColor=#5B6B82;strokeColor=#C83A3A;fontColor=#C83A3A;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" source="p5" target="p6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="결과" style="fontSize=11;endArrow=block