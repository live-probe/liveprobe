<mxfile host="app.diagrams.net" agent="LiveProbe docs/diagrams" type="device">
  <diagram name="1-A Workflow 선택 흐름" id="da5bdfa388085020b1d3">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sig" value="&lt;b&gt;이상 신호&lt;/b&gt;&lt;br&gt;Pod·Event 감시 / Endpoint 폴링&lt;br&gt;Alertmanager 경보(OOM·지연·풀·5xx)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E8F1FF;strokeColor=#3B6FD8;fontColor=#12305E;" vertex="1" parent="1"><mxGeometry x="38.67" y="12" width="240" height="70" as="geometry" /></mxCell><mxCell id="inc" value="&lt;b&gt;사건화 (incidents.ingest)&lt;/b&gt;&lt;br&gt;같은 지문 10분 병합 · 종료 후 90초 재발 억제&lt;br&gt;평가 잠금 중에는 무시 · 20초 대기 후 분석" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#5B6B82;fontColor=#1F2A37;" vertex="1" parent="1"><mxGeometry x="23.67" y="112" width="270" height="70" as="geometry" /></mxCell><mxCell id="evi" value="&lt;b&gt;근거 수집 E1~E7 (읽기 전용)&lt;/b&gt;&lt;br&gt;Deployment·리비전 / Pod / Service·Endpoint&lt;br&gt;Event / Prometheus 지표 / Loki 로그 / 호출자" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#F4F7FB;strokeColor=#8A9BB3;fontColor=#1F2A37;" vertex="1" parent="1"><mxGeometry x="18.67" y="272" width="280" height="80" as="geometry" /></mxCell><mxCell id="d_ev" value="핵심 근거&lt;br&gt;(deployment·pod·&lt;br&gt;service·endpoint)&lt;br&gt;수집 실패?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF7E0;strokeColor=#C99A1E;fontColor=#4A3A08;" vertex="1" parent="1"><mxGeometry x="73.67" y="382" width="170" height="110" as="geometry" /></mxCell><mxCell id="h_fail" value="&lt;b&gt;운영자 이관&lt;/b&gt;&lt;br&gt;router_failure&lt;br&gt;(자동 조치 없음)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FCE8E8;strokeColor=#C83A3A;fontColor=#561313;" vertex="1" parent="1"><mxGeometry x="440.33" y="1602" width="180" height="64" as="geometry" /></mxCell><mxCell id="d_hr" value="보호 자원(Node·Secret·NS)&lt;br&gt;또는 Selector 0&lt;br&gt;또는 경로 장애?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF7E0;strokeColor=#C99A1E;fontColor=#4A3A08;" vertex="1" parent="1"><mxGeometry x="30.33" y="584" width="200" height="120" as="geometry" /></mxCell><mxCell id="d_s" value="이미지/크래시 오류&lt;br&gt;+ 15분 내 롤아웃&lt;br&gt;+ 단일 workload?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF7E0;strokeColor=#C99A1E;fontColor=#4A3A08;" vertex="1" parent="1"><mxGeometry x="212" y="796" width="200" height="120" as="geometry" /></mxCell><mxCell id="d_n" value="OOM 또는&lt;br&gt;지연·연결 풀 신호?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF7E0;strokeColor=#C99A1E;fontColor=#4A3A08;" vertex="1" parent="1"><mxGeometry x="188.67" y="1008" width="180" height="110" as="geometry" /></mxCell><mxCell id="l_h" value="&lt;b&gt;HIGH_RISK&lt;/b&gt; (규칙 확정)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FCE8E8;strokeColor=#C83A3A;fontColor=#561313;" vertex="1" parent="1"><mxGeometry x="12" y="834" width="170" height="44" as="geometry" /></mxCell><mxCell id="l_s" value="&lt;b&gt;SIMPLE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E7F6EC;strokeColor=#2F9A55;fontColor=#11402A;" vertex="1" parent="1"><mxGeometry x="433.67" y="1041" width="140" height="44" as="geometry" /></mxCell><mxCell id="l_n" value="&lt;b&gt;NORMAL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E6F4F8;strokeColor=#2B8BAA;fontColor=#0E3A49;" vertex="1" parent="1"><mxGeometry x="353.67" y="1213" width="140" height="44" as="geometry" /></mxCell><mxCell id="l_c" value="&lt;b&gt;COMPLEX&lt;/b&gt;&lt;br&gt;(규칙에 안 맞음)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FDEEDC;strokeColor=#D27A1E;fontColor=#4D2A07;" vertex="1" parent="1"><mxGeometry x="173.67" y="1210" width="150" height="50" as="geometry" /></mxCell><mxCell id="llm" value="&lt;b&gt;LLM 분류기&lt;/b&gt; (router: gpt-6-luna/low)&lt;br&gt;수준을 &lt;u&gt;올리기만&lt;/u&gt; 가능 · 최대 COMPLEX&lt;br&gt;HIGH_RISK는 규칙만 선언 · 낮추자는 의견은 무시" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#F1EAFE;strokeColor=#7A55D8;fontColor=#2E1A66;" vertex="1" parent="1"><mxGeometry x="128.67" y="1302" width="300" height="76" as="geometry" /></mxCell><mxCell id="d_llm" value="분류 실패 또는&lt;br&gt;신뢰도 &amp;lt; 0.6?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF7E0;strokeColor=#C99A1E;fontColor=#4A3A08;" vertex="1" parent="1"><mxGeometry x="193.67" y="1408" width="170" height="100" as="geometry" /></mxCell><mxCell id="score" value="&lt;b&gt;주 분석 모델 선택 (score_models v2)&lt;/b&gt;&lt;br&gt;품질 0.6 + 비용 0.25(로그 척도) + 처리량 0.15&lt;br&gt;수준별 최소 품질 미달·가격 미상 모델 제외" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#F1EAFE;strokeColor=#7A55D8;fontColor=#2E1A66;" vertex="1" parent="1"><mxGeometry x="90.33" y="1602" width="320" height="76" as="geometry" /></mxCell><mxCell id="g_s" value="&lt;b&gt;simple_group&lt;/b&gt;&lt;br&gt;주 모델 gpt-6-luna&lt;br&gt;Agent 2 (분석·확인)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E7F6EC;strokeColor=#2F9A55;fontColor=#11402A;" vertex="1" parent="1"><mxGeometry x="524.33" y="1790" width="180" height="70" as="geometry" /></mxCell><mxCell id="g_n" value="&lt;b&gt;normal_group&lt;/b&gt;&lt;br&gt;주 모델 gpt-6.1-sol&lt;br&gt;Agent 4 (병렬 분석·조정·검증)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E6F4F8;strokeColor=#2B8BAA;fontColor=#0E3A49;" vertex="1" parent="1"><mxGeometry x="294.33" y="1790" width="200" height="70" as="geometry" /></mxCell><mxCell id="g_c" value="&lt;b&gt;complex_group&lt;/b&gt;&lt;br&gt;주 모델 gpt-6.1-sol&lt;br&gt;Agent 5 (원인 추론·반론·복구 계획)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FDEEDC;strokeColor=#D27A1E;fontColor=#4D2A07;" vertex="1" parent="1"><mxGeometry x="44.33" y="1790" width="220" height="70" as="geometry" /></mxCell><mxCell id="g_h" value="&lt;b&gt;high_risk_group&lt;/b&gt;&lt;br&gt;근거 정리 + 안전 검증&lt;br&gt;(gpt-6-astra/xhigh)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FCE8E8;strokeColor=#C83A3A;fontColor=#561313;" vertex="1" parent="1"><mxGeometry x="616" y="1917" width="200" height="70" as="geometry" /></mxCell><mxCell id="d_act" value="독립 검증 통과 +&lt;br&gt;제안자·검증자가&lt;br&gt;같은 조치?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF7E0;strokeColor=#C99A1E;fontColor=#4A3A08;" vertex="1" parent="1"><mxGeometry x="304.33" y="1892" width="180" height="120" as="geometry" /></mxCell><mxCell id="pol" value="&lt;b&gt;정책 판정&lt;/b&gt;&lt;br&gt;SIMPLE·NORMAL·COMPLEX = 자동&lt;br&gt;전역 approval / suggest_only / 일시정지 우선&lt;br&gt;실행 직전 사건 수준 재확인" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#5B6B82;fontColor=#1F2A37;" vertex="1" parent="1"><mxGeometry x="219.33" y="2104" width="290" height="80" as="geometry" /></mxCell><mxCell id="exe" value="&lt;b&gt;안전 실행기 (별도 쓰기 계정)&lt;/b&gt;&lt;br&gt;허용 조치 6종 · 복제 1..2 · 메모리 256..768Mi&lt;br&gt;before 스냅샷 · 동시성 검사 · admission 정책" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#5B6B82;fontColor=#1F2A37;" vertex="1" parent="1"><mxGeometry x="166" y="2276" width="300" height="80" as="geometry" /></mxCell><mxCell id="d_ver" value="실행 후&lt;br&gt;검증 통과?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF7E0;strokeColor=#C99A1E;fontColor=#4A3A08;" vertex="1" parent="1"><mxGeometry x="241" y="2386" width="150" height="100" as="geometry" /></mxCell><mxCell id="res" value="&lt;b&gt;해결 (resolved)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E7F6EC;strokeColor=#2F9A55;fontColor=#11402A;" vertex="1" parent="1"><mxGeometry x="211" y="2578" width="160" height="50" as="geometry" /></mxCell><mxCell id="comp" value="&lt;b&gt;보상 실행(원복)&lt;/b&gt;&lt;br&gt;→ 운영자 이관" style="rounded